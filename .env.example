# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# Channel ID (e.g. -1001234567890 or @kudrovo_chronicles)
CHANNEL_ID="-1001234567890"
# Discussion Supergroup ID (linked chat for comments, e.g. -1009876543210)
DISCUSSION_CHAT_ID="-1009876543210"
# Comma-separated list of admin Telegram user IDs
ADMIN_IDS="12345678,98765432"

# Narrator LLM (CodeCraft API - DeepSeek)
CODECRAFT_API_KEY="your-codecraft-api-key"
CODECRAFT_BASE_URL="https://codecraftapi.com/v1"
CODECRAFT_MODEL="deepseek-v4-flash-0731"

# Comment Agent LLM (Groq)
GROQ_API_KEY="your-groq-api-key"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-120b"

# Scheduling
# Cron expression: "minute hour day month day-of-week" (default 19:00 Moscow time)
SCHEDULE_CRON="0 19 * * *"
# Or set an interval in hours (if specified, overrides cron):
# SCHEDULE_INTERVAL_HOURS=12

# Database & General
DB_PATH="data/kudrovo.db"
TIMEZONE="Europe/Moscow"
